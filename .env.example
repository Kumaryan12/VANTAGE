# Local fallback; Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./vantage.db
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Optional server-side credentials. Leave blank for demo.
KITE_API_KEY=
KITE_API_SECRET=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# Compose database password; replace before any nonlocal deployment.
POSTGRES_PASSWORD=vantage_local_only

# Optional private model storage; relative paths resolve from the repository root.
MODEL_ARTIFACT_DIR=artifacts/models
# Optional image/source revision when .git is unavailable.
BUILD_COMMIT=

# Optional backend-only AI. No key is needed for risk/ML or deterministic investigation demos.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=12
EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_STORAGE_DIR=artifacts/documents
DOCUMENT_CHUNK_CHARS=1800
DOCUMENT_CHUNK_OVERLAP=180
# Optional billing estimates, from your provider/account pricing; omit if unknown.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=

# Phase 6 local development. Use infra/compose.production.yml for strict HTTPS deployment.
ENVIRONMENT=development
AUTH_REQUIRED=false
REGISTRATION_ENABLED=true
EXPOSE_API_DOCS=true
AUTH_SESSION_HOURS=12
AUTH_IDLE_MINUTES=60
JOB_BACKEND=local
REDIS_URL=redis://127.0.0.1:56379/0
MASTER_KEY_FILE=
MASTER_KEY_ACTIVE=v1
PRIVATE_STORAGE_DIR=artifacts/private
STORAGE_BACKEND=local
STORAGE_QUOTA_MB=250
SOURCE_QUOTA_MB=250
DOCUMENT_SANDBOX_REQUIRED=false
# Backend-only *_FILE settings are supported. Do not set a value and its file together.
# DATABASE_URL_FILE=/run/secrets/database_app_url
# REDIS_URL_FILE=/run/secrets/redis_url
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
