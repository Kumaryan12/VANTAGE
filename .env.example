# Local fallback; Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./vantage.db
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Optional server-side credentials. Leave blank for demo.
KITE_API_KEY=
KITE_API_SECRET=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# Compose database password; replace before any nonlocal deployment.
POSTGRES_PASSWORD=vantage_local_only

# Optional private model storage; relative paths resolve from the repository root.
MODEL_ARTIFACT_DIR=artifacts/models
# Optional image/source revision when .git is unavailable.
BUILD_COMMIT=

# Optional backend-only AI. No key is needed for risk/ML or deterministic investigation demos.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=12
EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_STORAGE_DIR=artifacts/documents
DOCUMENT_CHUNK_CHARS=1800
DOCUMENT_CHUNK_OVERLAP=180
# Optional billing estimates, from your provider/account pricing; omit if unknown.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=
